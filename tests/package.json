{
  "name": "tests",
  "version": "1.0.0",
  "description": "Projeto de testes E2E e de API para o SQA Social Media usando Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test tests/e2e.*.spec.ts",
